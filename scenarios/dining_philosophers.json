{
  "title": "Synchronisation — Dining Philosophers",
  "description": "Five philosophers each pick up their left fork, then their right. When everyone holds a left fork the wait-for graph is a 5-cycle: deadlock. Recovery is disabled so the cycle stays visible in the Resource Allocation Graph.",
  "demonstrates": [
    "Mutexes",
    "Circular wait",
    "Deadlock detection",
    "Resource Allocation Graph"
  ],
  "suggestedTicks": 200,
  "config": {
    "scheduler": "RR",
    "quantum": 2,
    "autoDeadlockRecovery": false
  },
  "processes": [
